# Bitmark Explorer — central credentials
# Used by: setup.sh, database/verify-schema.sh,
#           indexer/setup-env.sh, generator/install.sh
#
# The easiest way to fill this in is to run setup.sh — it will prompt for
# every value and write them here automatically.  Or copy and edit manually:
#
#   cp credentials.env.example credentials.env
#   chmod 600 credentials.env
#   $EDITOR credentials.env
#
# Variables already set in the calling environment always take priority.

# ── Explorer identity ─────────────────────────────────────────────────────────
# Public DNS hostname for this explorer instance.
# Drives the Apache vhost ServerName and the /var/www/<domain>/html web root.
EXPLORER_DOMAIN=

# ── System user ───────────────────────────────────────────────────────────────
# OS user that owns the bitmarkd process, wallet files, and bitmark.conf.
# The indexer service runs as this user.
INDEXER_USER=coins

# ── PostgreSQL superuser ───────────────────────────────────────────────────────
# Password for the 'postgres' OS/DB superuser.
# Leave blank when pg_hba.conf uses peer auth on the UNIX socket
# (the Debian default — 'sudo -u postgres psql' works without a password).
PGSU_PASS=

# ── Bitmark PostgreSQL application role ───────────────────────────────────────
# Password for the 'bitmark' database role used by the indexer and generator.
# Leave blank to have setup.sh generate a random password on first run.
DB_PASS=

# ── Bitmark node RPC ──────────────────────────────────────────────────────────
# Credentials matching rpcuser/rpcpassword in ~/.bitmark/bitmark.conf.
RPC_USER=bitmarkrpc
RPC_PASS=

# RPC port — Bitmark default is 9266 (differs from Bitcoin's 8332).
RPC_PORT=9266

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# Uncomment and change only if your setup differs from the standard layout.
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_NAME=bitmark
